---
/**
 * what-we-do.astro - Specialized Services & Capabilities Page
 * A highly polished, editorial page detailing Indido Apparel's sourcing,
 * design development, logistics, and sustainability consulting.
 * Refactored to use modular ServicesSlider and ProcessSlider components.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ServicesSlider from '../components/ServicesSlider.astro';
import ProcessSlider from '../components/ProcessSlider.astro';

// Image Imports matching the website's premium design
import fabricDetailRaw from '../assets/what_we_do_in1.png';
import productionImageRaw from '../assets/what_we_do_in2.png';
---

<Layout title="What We Do | Indido Apparel Sourcing & Consulting" description="Discover Indido Apparel's full range of services—from design consulting and material research to manufacturing quality control and global logistics.">
    <!-- Floating Ambient Orbs (Matching about-us layout) -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>

    <!-- Page Editorial Header -->
    <header class="story-hero-section reveal-on-scroll">
        <h1 class="story-main-title split-text-scroll">Your Trusted Partner in Global <em>Fashion Sourcing</em>.</h1>
    </header>

    <!-- Main Content Container -->
    <main class="story-container">

        <!-- Overlapping Mission Section (Image-Left, Card-Right) -->
        <section class="overlap-section reveal-on-scroll">
            <div class="overlap-grid">
                <!-- Left: Styled Image with Offset Border Frame -->
                <div class="overlap-image-container">
                    <div class="frame-backdrop"></div>
                    <Image src={fabricDetailRaw} alt="Fabric sourcing and detail research" class="overlap-img" width={700} />
                </div>
                <!-- Right: Overlapping Text Card -->
                <div class="overlap-card-wrapper">
                    <div class="overlap-card">
                        <header class="section-header">
                            <span class="section-number">Our Purpose</span>
                            <h2 class="section-title">Our <em>Mission</em></h2>
                            <span class="header-divider"></span>
                        </header>
                        <div class="section-body">
                            <p class="lead-paragraph">
                                To empower fashion brands worldwide with innovative, transparent, and sustainable sourcing solutions.
                            </p>
                            <p>
                                We are steadfastly committed to transforming your brightest ideas into exceptional, tangible products while simultaneously creating long-term value, fostering deep-rooted trust, and building mutually beneficial, lasting relationships with both our clients and our manufacturing partners across the globe. We succeed when you succeed.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Overlapping Vision Section (Reverse: Image-Right, Card-Left) -->
        <section class="overlap-section reverse reveal-on-scroll">
            <div class="overlap-grid">
                <!-- Right: Styled Image with Offset Border Frame -->
                <div class="overlap-image-container">
                    <div class="frame-backdrop"></div>
                    <Image src={productionImageRaw} alt="Garment production and quality control" class="overlap-img" width={700} />
                </div>
                <!-- Left: Overlapping Text Card -->
                <div class="overlap-card-wrapper">
                    <div class="overlap-card">
                        <header class="section-header">
                            <span class="section-number">Our Aspiration</span>
                            <h2 class="section-title">Our <em>Vision</em></h2>
                            <span class="header-divider"></span>
                        </header>
                        <div class="section-body">
                            <p class="lead-paragraph">
                                To be universally recognized as the world's most trusted, reliable, and approachable fashion sourcing partner.
                            </p>
                            <p>
                                We strive to set the ultimate industry standard, recognized everywhere for our unwavering integrity, our relentless pursuit of operational excellence, our innovative and forward-thinking spirit, and our deep dedication to sustainable, shared growth for people and the planet.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Specialized Services Container (Modular Slider) -->
        <ServicesSlider />

        <!-- Elegant Pullquote Highlight (Mission/Value statement) -->
        <div class="pullquote-block reveal-on-scroll">
            <div class="pullquote-line"></div>
            <blockquote>
                "Our comprehensive, integrated approach is strategically designed to provide you with exceptional garment quality, rapid speed to market, and unmatched cost efficiency."
            </blockquote>
            <div class="pullquote-line"></div>
        </div>

        <!-- Section: How We Work (Process workflow) -->
        <ProcessSlider />
    </main>
</Layout>

<style>
    /* Floating Ambient Particles (orb-1, orb-2, orb-3 matching about-us) */
    .ambient-orb {
        position: absolute;
        width: clamp(20rem, 40vw, 35rem);
        height: clamp(20rem, 40vw, 35rem);
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.18;
        pointer-events: none;
        z-index: -1;
    }
    .orb-1 {
        top: 15%;
        right: -10%;
        background: radial-gradient(circle, rgba(46, 112, 74, 0.25) 0%, transparent 70%);
    }
    .orb-2 {
        top: 45%;
        left: -15%;
        background: radial-gradient(circle, rgba(81, 99, 74, 0.2) 0%, transparent 70%);
    }
    .orb-3 {
        bottom: 10%;
        right: -5%;
        background: radial-gradient(circle, rgba(46, 112, 74, 0.2) 0%, transparent 70%);
    }

    /* Editorial Header */
    .story-hero-section {
        text-align: center;
        padding: clamp(5rem, 10vw, 8rem) 1.5rem 3rem;
        max-width: 90rem;
        margin: 0 auto;
    }
    .title-line-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        max-width: 28rem;
        margin: 0 auto 1.2rem;
    }
    .title-line {
        flex-grow: 1;
        height: 1px;
        background-color: var(--ink);
        opacity: 0.15;
    }
    .eyebrow {
        font-size: 0.76rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--thread);
    }
    .story-main-title {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: clamp(2rem, 3.8vw, 3.4rem);
        font-weight: 400;
        line-height: 1.2;
        color: var(--ink);
        max-width: none;
    }
    .story-main-title em {
        font-style: italic;
        color: var(--thread);
    }
    .story-subtitle {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 0.8rem;
        font-weight: 600;
    }

    /* Narrative Container - Stretches across screen */
    .story-container {
        max-width: 92rem;
        margin: 0 auto;
        padding: 0 3rem 8rem;
        display: flex;
        flex-direction: column;
        gap: 8rem;
    }

    /* Section structure details */
    .section-header {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        position: relative;
        margin-bottom: 2rem;
    }
    .section-number {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--thread);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .section-title {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: clamp(1.4rem, 2.5vw, 1.8rem);
        font-weight: 400;
        color: var(--ink);
        margin: 0;
    }
    .section-title em {
        font-style: italic;
    }
    .header-divider {
        width: 3rem;
        height: 1px;
        background-color: var(--thread);
        margin-top: 1rem;
        display: block;
    }

    .section-body {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }
    .section-body p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--muted);
        margin: 0;
    }
    .lead-paragraph {
        font-size: 1.18rem !important;
        line-height: 1.7 !important;
        color: var(--ink) !important;
        font-weight: 500;
    }

    /* Pullquote block */
    .pullquote-block {
        text-align: center;
        max-width: 44rem;
        margin: 1rem auto;
    }
    .pullquote-line {
        height: 1px;
        background-color: var(--line);
    }
    .pullquote-block blockquote {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: clamp(1.3rem, 2.2vw, 1.8rem);
        font-style: italic;
        line-height: 1.45;
        color: var(--thread);
        padding: 2.2rem 1rem;
        margin: 0;
    }

    /* Overlapping Section Styling */
    .overlap-section {
        width: 100%;
        margin-top: 3rem;
    }

    .overlap-grid {
        display: grid;
        grid-template-columns: 0.82fr 1.18fr;
        align-items: center;
        position: relative;
    }

    .overlap-image-container {
        position: relative;
        width: 100%;
        max-width: 36rem;
        margin: 0 auto;
        display: block;
    }

    .overlap-img {
        width: 100%;
        aspect-ratio: 1.5 / 1;
        object-fit: cover;
        border-radius: 4px;
        position: relative;
        z-index: 2;
        box-shadow: 0 1rem 3rem rgba(23, 32, 28, 0.08);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .frame-backdrop {
        position: absolute;
        top: -16px;
        left: -16px;
        width: 100%;
        height: 100%;
        border: 2px solid var(--thread);
        border-radius: 4px;
        pointer-events: none;
        z-index: 1;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .overlap-image-container:hover .overlap-img {
        transform: translate(4px, 4px);
    }
    .overlap-image-container:hover .frame-backdrop {
        transform: translate(-4px, -4px);
    }

    .overlap-card-wrapper {
        position: relative;
        z-index: 3;
        margin-left: -8rem;
    }

    .overlap-card {
        background: var(--cotton);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: clamp(2.5rem, 4vw, 3.5rem);
        text-align: left;
        box-shadow: 0 1.5rem 4rem rgba(23, 32, 28, 0.04);
        transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
    }

    .overlap-card:hover {
        border-color: var(--thread);
        box-shadow: 0 2rem 5rem rgba(23, 32, 28, 0.07);
        transform: translateY(-2px);
    }

    /* Reverse overlapping alignment styling */
    .overlap-section.reverse .overlap-grid {
        grid-template-columns: 1.18fr 0.82fr;
    }
    .overlap-section.reverse .overlap-image-container {
        grid-column: 2;
        grid-row: 1;
    }
    .overlap-section.reverse .overlap-card-wrapper {
        grid-column: 1;
        grid-row: 1;
        margin-left: 0;
        margin-right: -8rem;
    }
    .overlap-section.reverse .frame-backdrop {
        left: auto;
        right: -16px;
    }
    .overlap-section.reverse .overlap-image-container:hover .overlap-img {
        transform: translate(-4px, 4px);
    }
    .overlap-section.reverse .overlap-image-container:hover .frame-backdrop {
        transform: translate(4px, -4px);
    }

    @media (max-width: 1200px) {
        .overlap-card-wrapper {
            margin-left: -4.5rem;
        }
        .overlap-section.reverse .overlap-card-wrapper {
            margin-right: -4.5rem;
        }
    }

    @media (max-width: 992px) {
        .overlap-grid {
            grid-template-columns: 0.85fr 1.15fr;
        }
        .overlap-card-wrapper {
            margin-left: -2rem;
        }
        .overlap-section.reverse .overlap-grid {
            grid-template-columns: 1.15fr 0.85fr;
        }
        .overlap-section.reverse .overlap-card-wrapper {
            margin-right: -2rem;
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .story-container {
            gap: 3.5rem;
        }
        .overlap-section {
            margin-top: 1rem;
        }
        .overlap-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .frame-backdrop {
            top: -10px;
            left: -10px;
        }
        .overlap-card-wrapper {
            margin-left: 0;
            width: 100%;
        }
        .overlap-card {
            padding: 2rem;
            text-align: center !important;
        }
        .header-divider {
            margin-left: auto !important;
            margin-right: auto !important;
        }

        /* Reset reverse layout on small viewports so they stack logically */
        .overlap-section.reverse .overlap-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .overlap-section.reverse .overlap-image-container {
            grid-column: auto;
            grid-row: auto;
        }
        .overlap-section.reverse .overlap-card-wrapper {
            grid-column: auto;
            grid-row: auto;
            margin-right: 0;
        }
        .overlap-section.reverse .frame-backdrop {
            right: auto;
            left: -10px;
        }
    }
</style>
