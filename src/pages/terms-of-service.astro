---
/**
 * terms-of-service.astro - Terms of Service
 * High-end commercial terms governing the legal relationship between the agency
 * and client brands.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms of Service | Indido Apparel" description="Read Indido Apparel's Terms of Service. Discover the scope of our sourcing agency services, payment structures, and intellectual property rights.">
    <!-- Floating Ambient Orbs (Pristine light particles matching home page) -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>

    <!-- Editorial Header -->
    <header class="story-hero-section reveal-on-scroll">
        <div class="title-line-container">
            <span class="title-line"></span>
            <span class="eyebrow">COMMERCIAL TERMS</span>
            <span class="title-line"></span>
        </div>
        <h1 class="story-main-title split-text-scroll">Terms of <em>Service</em></h1>
        <p class="story-subtitle split-text-scroll">Effective Date: July 2026</p>
    </header>

    <!-- Main Content Container -->
    <main class="story-container">
        <div class="legal-content-wrapper reveal-on-scroll">
            <p class="legal-intro">
                These Terms of Service ("Terms") govern the commercial relationship between Indido Apparel ("Agency") and client brands or buyers ("Clients") utilizing our sourcing coordination, product development, and quality assurance supervision services.
            </p>

            <hr class="legal-divider" />

            <section class="legal-section">
                <h2>1. Scope of Agency Services</h2>
                <p>
                    Indido Apparel operates as a professional sourcing agent, manufacturer coordinator, and quality supervisor. We provide product development advisory, fabric sourcing, production coordination, and final quality inspections (AQL standards).
                </p>
                <p>
                    <strong>Independent Liability:</strong> Indido Apparel coordinates and oversees the production cycle but is not the manufacturer. All actual physical production is executed by vetted independent factory partners. Operational liabilities related to manufacturing errors, fabric shrinkage, or machine defects remain the responsibility of the contracted manufacturing factory.
                </p>
            </section>

            <section class="legal-section">
                <h2>2. Intellectual Property Rights</h2>
                <p>
                    We strictly uphold intellectual property rights across all sourcing operations:
                </p>
                <ul>
                    <li><strong>Client Designs:</strong> The Client retains 100% sole ownership of all tech packs, CAD designs, sketches, logo graphics, and custom patterns provided to the Agency for development.</li>
                    <li><strong>Agency Intellectual Property:</strong> The Agency retains full ownership and rights over its proprietary sourcing databases, vendor networks, workflow management tools, and proprietary software systems.</li>
                </ul>
            </section>

            <section class="legal-section">
                <h2>3. Payment & Commission Terms</h2>
                <p>
                    All sourcing transactions and coordinating services are subject to predefined payment terms established in separate Client Sourcing Agreements:
                </p>
                <ul>
                    <li><strong>Deposit Requirements:</strong> Sourcing and manufacturing programs typically require a standard deposit prior to sample or bulk fabric booking, as outlined in individual cost sheets.</li>
                    <li><strong>Letters of Credit (L/C):</strong> Large-scale bulk orders are executed via Irrevocable Letters of Credit at Sight (L/C at Sight) or advanced bank transfers, unless otherwise agreed.</li>
                    <li><strong>Agency Commission:</strong> Sourcing coordination commissions are calculated as a percentage of the Free On Board (FOB) price and are clearly detailed in proforma invoices.</li>
                </ul>
            </section>

            <section class="legal-section">
                <h2>4. Limitation of Liability & Force Majeure</h2>
                <p>
                    Indido Apparel shall not be held liable for delays, losses, or production failures resulting from circumstances beyond its reasonable control (Force Majeure):
                </p>
                <ul>
                    <li><strong>Supply Chain Bottlenecks:</strong> Shipping port delays, logistics bottlenecks, customs inspections, and international transit disruptions.</li>
                    <li><strong>Sourcing Delays:</strong> Raw yarn shortages, fabric mill dye delays, or energy restrictions affecting manufacturing facilities.</li>
                    <li><strong>Uncontrollable Events:</strong> Natural disasters, pandemics, regional labor disruptions, or government restrictions.</li>
                </ul>
            </section>

            <section class="legal-section">
                <h2>5. Governing Law</h2>
                <p>
                    These Terms and all separate sourcing agreements shall be governed by and construed in accordance with the laws of India, and any disputes shall be settled under the exclusive jurisdiction of the competent courts of New Delhi.
                </p>
            </section>
        </div>
    </main>
</Layout>
