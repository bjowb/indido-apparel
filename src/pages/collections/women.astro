---
/**
 * women.astro - Architectural Lookbook Catalog (Women's)
 * Refactored to use modular ProductCard.
 */
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CollectionNav from '../../components/CollectionNav.astro';

// Newly categorized women images
const womenTopsGlob = import.meta.glob('../../assets/categorized_images/women/tops and blouses/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenDressesGlob = import.meta.glob('../../assets/categorized_images/women/dresses/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenBottomsGlob = import.meta.glob('../../assets/categorized_images/women/bottoms/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCoordsGlob = import.meta.glob('../../assets/categorized_images/women/co-ords/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const websiteWomenActiveGlob = import.meta.glob('../../assets/Website Product Images/Women/Activewear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWomenBottomsGlob = import.meta.glob('../../assets/Website Product Images/Women/Bottoms/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWomenCoordsGlob = import.meta.glob('../../assets/Website Product Images/Women/Co-ord Sets And Lounge Wear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWomenDressesGlob = import.meta.glob('../../assets/Website Product Images/Women/Dresses And Jumpsuits/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWomenOutwearGlob = import.meta.glob('../../assets/Website Product Images/Women/Outwear And layering/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWomenTopsGlob = import.meta.glob('../../assets/Website Product Images/Women/Tops & Blouses/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const newWomenTops = Object.keys(womenTopsGlob).map((key, idx) => ({
    id: `women-tops-new-${idx}`,
    image: (womenTopsGlob[key] as any).default
}));
const newWomenDresses = Object.keys(womenDressesGlob).map((key, idx) => ({
    id: `women-dresses-new-${idx}`,
    image: (womenDressesGlob[key] as any).default
}));
const newWomenBottoms = Object.keys(womenBottomsGlob).map((key, idx) => ({
    id: `women-bottoms-new-${idx}`,
    image: (womenBottomsGlob[key] as any).default
}));
const newWomenCoords = Object.keys(womenCoordsGlob).map((key, idx) => ({
    id: `women-coords-new-${idx}`,
    image: (womenCoordsGlob[key] as any).default
}));

const websiteWomenActive = Object.keys(websiteWomenActiveGlob).map((key, idx) => ({
    id: `women-active-website-${idx}`,
    image: (websiteWomenActiveGlob[key] as any).default
}));
const websiteWomenBottoms = Object.keys(websiteWomenBottomsGlob).map((key, idx) => ({
    id: `women-bottoms-website-${idx}`,
    image: (websiteWomenBottomsGlob[key] as any).default
}));
const websiteWomenCoords = Object.keys(websiteWomenCoordsGlob).map((key, idx) => ({
    id: `women-coords-website-${idx}`,
    image: (websiteWomenCoordsGlob[key] as any).default
}));
const websiteWomenDresses = Object.keys(websiteWomenDressesGlob).map((key, idx) => ({
    id: `women-dresses-website-${idx}`,
    image: (websiteWomenDressesGlob[key] as any).default
}));
const websiteWomenOutwear = Object.keys(websiteWomenOutwearGlob).map((key, idx) => ({
    id: `women-outwear-website-${idx}`,
    image: (websiteWomenOutwearGlob[key] as any).default
}));
const websiteWomenTops = Object.keys(websiteWomenTopsGlob).map((key, idx) => ({
    id: `women-tops-website-${idx}`,
    image: (websiteWomenTopsGlob[key] as any).default
}));

// Load legacy women_coll directories dynamically
const womenCollTopsGlob = import.meta.glob('../../assets/women_coll/tops&blouse/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCollKurti5Glob = import.meta.glob('../../assets/women_coll/kurti/5/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCollKurti6Glob = import.meta.glob('../../assets/women_coll/kurti/6/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const womenCollDressesGlob = import.meta.glob('../../assets/women_coll/dresses/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCollKurti7Glob = import.meta.glob('../../assets/women_coll/kurti/7/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCollKurti8Glob = import.meta.glob('../../assets/women_coll/kurti/8/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const womenCollBottomsGlob = import.meta.glob('../../assets/women_coll/bottoms/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const womenCollCoordsGlob = import.meta.glob('../../assets/women_coll/coords/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const womenCollSareeGlob = import.meta.glob('../../assets/women_coll/saree/**/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

// Map them to arrays
const existingTops = [
    ...Object.keys(womenCollKurti5Glob).map(k => (womenCollKurti5Glob[k] as any).default),
    ...Object.keys(womenCollKurti6Glob).map(k => (womenCollKurti6Glob[k] as any).default),
    ...Object.keys(womenCollTopsGlob).map(k => (womenCollTopsGlob[k] as any).default)
].map((img, idx) => ({ id: `women-t-old-${idx}`, image: img }));

const existingDresses = [
    ...Object.keys(womenCollKurti7Glob).map(k => (womenCollKurti7Glob[k] as any).default),
    ...Object.keys(womenCollKurti8Glob).map(k => (womenCollKurti8Glob[k] as any).default),
    ...Object.keys(womenCollDressesGlob).map(k => (womenCollDressesGlob[k] as any).default)
].map((img, idx) => ({ id: `women-d-old-${idx}`, image: img }));

const existingBottoms = Object.keys(womenCollBottomsGlob)
    .map(k => (womenCollBottomsGlob[k] as any).default)
    .map((img, idx) => ({ id: `women-b-old-${idx}`, image: img }));

const existingCoords = [
    ...Object.keys(womenCollSareeGlob).map(k => (womenCollSareeGlob[k] as any).default),
    ...Object.keys(womenCollCoordsGlob).map(k => (womenCollCoordsGlob[k] as any).default)
].map((img, idx) => ({ id: `women-c-old-${idx}`, image: img }));

const categories = [
    {
        name: "Tops & Blouses",
        description: "Elegant kurtis, everyday tunics, and premium custom shirts designed for comfort.",
        products: [...websiteWomenTops]
    },
    {
        name: "Dresses & Jumpsuits",
        description: "Flowy day dresses, long tunics, and modern single-piece ensembles.",
        products: [...websiteWomenDresses]
    },
    {
        name: "Bottoms",
        description: "Premium washed denims, high-rise trousers, and relaxed fit options.",
        products: [...websiteWomenBottoms]
    },
    {
    name: "Co-ord Sets & Lounge Wear",
        description: "Exquisite matching sets, traditional draped sarees, and coordinated apparel.",
        products: [...websiteWomenCoords]
    },
    {
        name: "Outerwear & Layering",
        description: "Lightweight cardigans, versatile jackets, and stylish outerwear layers.",
        products: [...websiteWomenOutwear]
    },
    {
        name: "Activewear",
        description: "High-comfort athletic wear, stretch leggings, and performance sports tops.",
        products: [...websiteWomenActive]
    }
];
---

<Layout title="Women's Collection | Indido Apparel" description="Explore the latest Women's collection at Indido Apparel. Premium kurtis, tunics, suits, and sarees.">
    <!-- Header Section -->
    <div class="collections-title-wrapper reveal-on-scroll">
        <div class="title-line-container">
            <span class="title-line"></span>
            <h1 class="collections-title">Women's Collection</h1>
            <span class="title-line"></span>
        </div>
        <p class="subtitle-text">Curated luxury. Premium cotton, linen, and silk programs.</p>
    </div>

    <!-- Category Selector Nav Bar -->
    <nav class="category-nav-bar reveal-on-scroll">
        {categories.map((category) => {
            const id = category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            return (
                <a href={`#${id}`} class="category-nav-link">
                    {category.name}
                </a>
            );
        })}
    </nav>

    <!-- Product Sections by Category -->
    {categories.map((category) => (
        <section class="product-grid-section" id={category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <div class="category-header reveal-on-scroll">
                <h2 class="category-title">{category.name}</h2>
                <p class="category-desc">{category.description}</p>
                <span class="category-divider"></span>
            </div>
            <div class="product-grid">
                {category.products.map((product, idx) => (
                    <ProductCard
                        image={product.image}
                        delay={idx * 50}
                    />
                ))}
            </div>
        </section>
    ))}
    <CollectionNav />
</Layout>

<style>
    .collections-title-wrapper {
        text-align: center;
        margin: clamp(4rem, 6vw, 6rem) auto 3rem;
        padding: 0 1rem;
    }
    .title-line-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        max-width: 60rem;
        margin: 0 auto;
    }
    .title-line {
        flex-grow: 1;
        height: 1px;
        background-color: var(--ink, #17201c);
        opacity: 0.15;
    }
    .collections-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.6rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0;
        white-space: nowrap;
    }
    .subtitle-text {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--muted, #64748b);
        margin-top: 0.8rem;
        text-transform: uppercase;
    }

    /* Product Grid Styling */
    .product-grid-section {
        background: var(--paper);
        padding-bottom: clamp(3rem, 5vw, 5rem);
    }
    .category-header {
        text-align: center;
        margin: 2rem auto 2.5rem auto;
        padding: 0 1.5rem;
        max-width: 45rem;
    }
    .category-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.4rem);
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0 0 0.5rem 0;
    }
    .category-desc {
        font-size: 0.88rem;
        color: var(--muted, #64748b);
        line-height: 1.6;
        margin: 0;
    }
    .category-divider {
        display: block;
        width: 3rem;
        height: 2px;
        background-color: var(--thread, #2e704a);
        margin: 1.25rem auto 0 auto;
    }
    
    /* Category Nav Bar */
    .category-nav-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.8rem;
        margin: -1rem auto 3.5rem auto;
        padding: 0.5rem 1.5rem;
        max-width: 90%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }
    /* Hide scrollbar but keep functionality */
    .category-nav-bar::-webkit-scrollbar {
        display: none;
    }
    .category-nav-bar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .category-nav-link {
        font-family: var(--body-font), sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted, #64748b);
        padding: 0.6rem 1.2rem;
        border-radius: 40px;
        border: 1px solid var(--line, rgba(13, 30, 21, 0.08));
        background-color: var(--cotton, #faf9f6);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        display: inline-block;
        white-space: nowrap;
        scroll-snap-align: start;
    }
    .category-nav-link:hover {
        color: var(--cotton, #faf9f6) !important;
        border-color: var(--thread, #2e704a);
        background-color: var(--thread, #2e704a);
        box-shadow: 0 4px 12px rgba(46, 112, 74, 0.15);
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.8rem;
        padding: 0 clamp(1rem, 4vw, 4rem);
        max-width: 90rem;
        margin: 0 auto;
    }

    /* Responsiveness */
    @media (max-width: 1024px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 768px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.2rem;
        }
    }
    @media (max-width: 480px) {
        .product-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
