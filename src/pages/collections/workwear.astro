---
/**
 * workwear.astro - Architectural Lookbook Catalog (Workwear)
 * Refactored to use modular ProductCard.
 */
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CollectionNav from '../../components/CollectionNav.astro';

const oldWorkGlob = import.meta.glob('../../assets/work_coll/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const workwearGlob = import.meta.glob('../../assets/categorized_images/workwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteWorkwearGlob = import.meta.glob('../../assets/Website Product Images/Workwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const existingProducts = Object.keys(oldWorkGlob).map((key, idx) => ({
    id: `work-old-${idx}`,
    image: (oldWorkGlob[key] as any).default
}));
const newProducts = Object.keys(workwearGlob).map((key, idx) => ({
    id: `work-new-${idx}`,
    image: (workwearGlob[key] as any).default
}));
const websiteProducts = Object.keys(websiteWorkwearGlob).map((key, idx) => ({
    id: `work-website-${idx}`,
    image: (websiteWorkwearGlob[key] as any).default
}));

const products = [...websiteProducts];
---

<Layout title="Workwear Collection | Indido Apparel" description="Explore the heavy-duty and functional Workwear collection at Indido Apparel. Built for strength, presentation, and durability.">
    <!-- Header Section -->
    <div class="collections-title-wrapper reveal-on-scroll">
        <div class="title-line-container">
            <span class="title-line"></span>
            <h1 class="collections-title">Workwear Collection</h1>
            <span class="title-line"></span>
        </div>
        <p class="subtitle-text">Function, Strength & Presentation. Built to withstand demanding daily environments.</p>
    </div>

    <!-- Product Grid -->
    <section class="product-grid-section">
        <div class="product-grid">
            {products.map((product, idx) => (
                <ProductCard
                    image={product.image}
                    delay={idx * 50}
                />
            ))}
        </div>
    </section>
    <CollectionNav />
</Layout>

<style>
    .collections-title-wrapper {
        text-align: center;
        margin: clamp(4rem, 6vw, 6rem) auto 3rem;
        padding: 0 1rem;
    }
    .title-line-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        max-width: 60rem;
        margin: 0 auto;
    }
    .title-line {
        flex-grow: 1;
        height: 1px;
        background-color: var(--ink, #17201c);
        opacity: 0.15;
    }
    .collections-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.6rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0;
        white-space: nowrap;
    }
    .subtitle-text {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--muted, #64748b);
        margin-top: 0.8rem;
        text-transform: uppercase;
    }

    /* Product Grid Styling */
    .product-grid-section {
        background: var(--paper);
        padding-bottom: 8rem;
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.8rem;
        padding: 0 clamp(1rem, 4vw, 4rem);
        max-width: 90rem;
        margin: 0 auto;
    }

    /* Responsiveness */
    @media (max-width: 1024px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 768px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.2rem;
        }
    }
    @media (max-width: 480px) {
        .product-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
