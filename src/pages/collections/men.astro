---
/**
 * men.astro - Architectural Lookbook Catalog (Men's)
 * Refactored to use modular ProductCard.
 */
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CollectionNav from '../../components/CollectionNav.astro';

// Newly categorized men images
const menCasualsGlob = import.meta.glob('../../assets/categorized_images/men/casuals/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const menBottomsGlob = import.meta.glob('../../assets/categorized_images/men/bottoms/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const menOutwearGlob = import.meta.glob('../../assets/categorized_images/men/outwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const menFormalGlob = import.meta.glob('../../assets/categorized_images/men/formal/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const websiteMenCasualGlob = import.meta.glob('../../assets/Website Product Images/Men/Casual And Everyday Tops/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteMenBottomsGlob = import.meta.glob('../../assets/Website Product Images/Men/Bottoms/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteMenOutwearGlob = import.meta.glob('../../assets/Website Product Images/Men/Outerwear & Layering/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteMenFormalGlob = import.meta.glob('../../assets/Website Product Images/Men/Formal & Tailored/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteMenActiveGlob = import.meta.glob('../../assets/Website Product Images/Men/Activewear & Athleisure/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const newMenCasuals = Object.keys(menCasualsGlob).map((key, idx) => ({
    id: `men-casual-new-${idx}`,
    image: (menCasualsGlob[key] as any).default
}));
const newMenBottoms = Object.keys(menBottomsGlob).map((key, idx) => ({
    id: `men-bottoms-new-${idx}`,
    image: (menBottomsGlob[key] as any).default
}));
const newMenOutwear = Object.keys(menOutwearGlob).map((key, idx) => ({
    id: `men-outwear-new-${idx}`,
    image: (menOutwearGlob[key] as any).default
}));
const newMenFormal = Object.keys(menFormalGlob).map((key, idx) => ({
    id: `men-formal-new-${idx}`,
    image: (menFormalGlob[key] as any).default
}));

const websiteMenCasual = Object.keys(websiteMenCasualGlob).map((key, idx) => ({
    id: `men-casual-website-${idx}`,
    image: (websiteMenCasualGlob[key] as any).default
}));
const websiteMenBottoms = Object.keys(websiteMenBottomsGlob).map((key, idx) => ({
    id: `men-bottoms-website-${idx}`,
    image: (websiteMenBottomsGlob[key] as any).default
}));
const websiteMenOutwear = Object.keys(websiteMenOutwearGlob).map((key, idx) => ({
    id: `men-outwear-website-${idx}`,
    image: (websiteMenOutwearGlob[key] as any).default
}));
const websiteMenFormal = Object.keys(websiteMenFormalGlob).map((key, idx) => ({
    id: `men-formal-website-${idx}`,
    image: (websiteMenFormalGlob[key] as any).default
}));
const websiteMenActive = Object.keys(websiteMenActiveGlob).map((key, idx) => ({
    id: `men-active-website-${idx}`,
    image: (websiteMenActiveGlob[key] as any).default
}));

// Load the legacy men_coll images dynamically
const menCollGlob = import.meta.glob('../../assets/men_coll/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const menCollImages = Object.keys(menCollGlob).map(key => ({
    path: key,
    image: (menCollGlob[key] as any).default
}));

const existingCasual = menCollImages.filter(img => 
    img.path.includes('men_1') || img.path.includes('men_2') || img.path.includes('men_3') || img.path.includes('men_4')
).map((img, idx) => ({ id: `men-c-old-${idx}`, image: img.image }));

const existingOutwear = menCollImages.filter(img => 
    img.path.includes('men_5') || img.path.includes('men_6')
).map((img, idx) => ({ id: `men-o-old-${idx}`, image: img.image }));

const existingFormal = menCollImages.filter(img => 
    img.path.includes('men_7') || img.path.includes('men_8') || img.path.includes('men_9') || img.path.includes('men_10') || img.path.includes('pdf_CP')
).map((img, idx) => ({ id: `men-f-old-${idx}`, image: img.image }));

// Bottoms: we had denim2, denim5 from denim_coll.
const denimCollGlob = import.meta.glob('../../assets/denim_coll/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const existingBottoms = Object.keys(denimCollGlob)
    .filter(key => key.includes('denim2') || key.includes('denim5'))
    .map((key, idx) => ({ id: `men-b-old-${idx}`, image: (denimCollGlob[key] as any).default }));



const categories = [
    {
        name: "Casual & Everyday Tops",
        description: "Premium cotton, linen, and dobby weave shirts designed for regular daily wear.",
        products: [ ...websiteMenCasual]
    },
    {
        name: "Bottoms",
        description: "Comfortable slim-fit denim, structured trousers, and stretch chino programs.",
        products: [ ...websiteMenBottoms]
    },
    {
        name: "Outerwear & Layering",
        description: "Structured cotton overshirts and daily casual layering essentials.",
        products: [...websiteMenOutwear]
    },
    {
        name: "Formal & Tailored",
        description: "Immaculately tailored shirts and kurta designs for formal or festive events.",
        products: [...websiteMenFormal]
    },
    {
        name: "Activewear & Athleisure",
        description: "High-performance shirts, joggers, and activewear for performance and comfort.",
        products: [...websiteMenActive]
    }
];
---

<Layout title="Men's Collection | Indido Apparel" description="Explore the latest Men's collection at Indido Apparel. Clean, premium lookbook cotton and linen shirts.">
    <!-- Header Section -->
    <div class="collections-title-wrapper reveal-on-scroll">
        <div class="title-line-container">
            <span class="title-line"></span>
            <h1 class="collections-title">Men's Collection</h1>
            <span class="title-line"></span>
        </div>
        <p class="subtitle-text">Structured tailoring. Premium linen and combed cotton programs.</p>
    </div>

    <!-- Category Selector Nav Bar -->
    <nav class="category-nav-bar reveal-on-scroll">
        {categories.map((category) => {
            const id = category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            return (
                <a href={`#${id}`} class="category-nav-link">
                    {category.name}
                </a>
            );
        })}
    </nav>

    <!-- Product Sections by Category -->
    {categories.map((category) => (
        <section class="product-grid-section" id={category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <div class="category-header reveal-on-scroll">
                <h2 class="category-title">{category.name}</h2>
                <p class="category-desc">{category.description}</p>
                <span class="category-divider"></span>
            </div>
            <div class="product-grid">
                {category.products.map((product, idx) => (
                    <ProductCard
                        image={product.image}
                        delay={idx * 50}
                    />
                ))}
            </div>
        </section>
    ))}
    <CollectionNav />
</Layout>

<style>
    .collections-title-wrapper {
        text-align: center;
        margin: clamp(4rem, 6vw, 6rem) auto 3rem;
        padding: 0 1rem;
    }
    .title-line-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        max-width: 60rem;
        margin: 0 auto;
    }
    .title-line {
        flex-grow: 1;
        height: 1px;
        background-color: var(--ink, #17201c);
        opacity: 0.15;
    }
    .collections-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.6rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0;
        white-space: nowrap;
    }
    .subtitle-text {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--muted, #64748b);
        margin-top: 0.8rem;
        text-transform: uppercase;
    }

    /* Product Grid Styling */
    .product-grid-section {
        background: var(--paper);
        padding-bottom: clamp(3rem, 5vw, 5rem);
    }
    .category-header {
        text-align: center;
        margin: 2rem auto 2.5rem auto;
        padding: 0 1.5rem;
        max-width: 45rem;
    }
    .category-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.4rem);
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0 0 0.5rem 0;
    }
    .category-desc {
        font-size: 0.88rem;
        color: var(--muted, #64748b);
        line-height: 1.6;
        margin: 0;
    }
    .category-divider {
        display: block;
        width: 3rem;
        height: 2px;
        background-color: var(--thread, #2e704a);
        margin: 1.25rem auto 0 auto;
    }
    
    /* Category Nav Bar */
    .category-nav-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.8rem;
        margin: -1rem auto 3.5rem auto;
        padding: 0.5rem 1.5rem;
        max-width: 90%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }
    /* Hide scrollbar but keep functionality */
    .category-nav-bar::-webkit-scrollbar {
        display: none;
    }
    .category-nav-bar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .category-nav-link {
        font-family: var(--body-font), sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted, #64748b);
        padding: 0.6rem 1.2rem;
        border-radius: 40px;
        border: 1px solid var(--line, rgba(13, 30, 21, 0.08));
        background-color: var(--cotton, #faf9f6);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        display: inline-block;
        white-space: nowrap;
        scroll-snap-align: start;
    }
    .category-nav-link:hover {
        color: var(--cotton, #faf9f6) !important;
        border-color: var(--thread, #2e704a);
        background-color: var(--thread, #2e704a);
        box-shadow: 0 4px 12px rgba(46, 112, 74, 0.15);
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.8rem;
        padding: 0 clamp(1rem, 4vw, 4rem);
        max-width: 90rem;
        margin: 0 auto;
    }

    /* Responsiveness */
    @media (max-width: 1024px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 768px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.2rem;
        }
    }
    @media (max-width: 480px) {
        .product-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
