---
/**
 * child.astro - Architectural Lookbook Catalog (Children's)
 * Refactored to use modular ProductCard and categories.
 */
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import CollectionNav from '../../components/CollectionNav.astro';

// Newly categorized kids images
const kidsCasualGlob = import.meta.glob('../../assets/categorized_images/kids/casual/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const kidsOutwearGlob = import.meta.glob('../../assets/categorized_images/kids/outwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const kidsSpecializedGlob = import.meta.glob('../../assets/categorized_images/kids/specialized/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const kidsNightwearGlob = import.meta.glob('../../assets/categorized_images/kids/nightwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const websiteKidsCasualGlob = import.meta.glob('../../assets/Website Product Images/Kids/Casual Tops/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteKidsDailyGlob = import.meta.glob('../../assets/Website Product Images/Kids/Daily Outfits/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteKidsNightwearGlob = import.meta.glob('../../assets/Website Product Images/Kids/Nightwear/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const websiteKidsOutwearGlob = import.meta.glob('../../assets/Website Product Images/Kids/Outwear And Layering/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });

const newCasual = Object.keys(kidsCasualGlob).map((key, idx) => ({
    id: `kids-casual-new-${idx}`,
    image: (kidsCasualGlob[key] as any).default
}));
const newOutwear = Object.keys(kidsOutwearGlob).map((key, idx) => ({
    id: `kids-outwear-new-${idx}`,
    image: (kidsOutwearGlob[key] as any).default
}));
const newSpecialized = Object.keys(kidsSpecializedGlob).map((key, idx) => ({
    id: `kids-specialized-new-${idx}`,
    image: (kidsSpecializedGlob[key] as any).default
}));
const newNightwear = Object.keys(kidsNightwearGlob).map((key, idx) => ({
    id: `kids-nightwear-new-${idx}`,
    image: (kidsNightwearGlob[key] as any).default
}));

const websiteKidsCasual = Object.keys(websiteKidsCasualGlob).map((key, idx) => ({
    id: `kids-casual-website-${idx}`,
    image: (websiteKidsCasualGlob[key] as any).default
}));
const websiteKidsDaily = Object.keys(websiteKidsDailyGlob).map((key, idx) => ({
    id: `kids-daily-website-${idx}`,
    image: (websiteKidsDailyGlob[key] as any).default
}));
const websiteKidsNightwear = Object.keys(websiteKidsNightwearGlob).map((key, idx) => ({
    id: `kids-nightwear-website-${idx}`,
    image: (websiteKidsNightwearGlob[key] as any).default
}));
const websiteKidsOutwear = Object.keys(websiteKidsOutwearGlob).map((key, idx) => ({
    id: `kids-outwear-website-${idx}`,
    image: (websiteKidsOutwearGlob[key] as any).default
}));

// Load the legacy kid_coll images dynamically
const kidCollGlob = import.meta.glob('../../assets/kid_coll/*.{png,jpg,jpeg,webp,JPG,JPEG,WEBP}', { eager: true });
const kidCollImages = Object.keys(kidCollGlob).map(key => ({
    path: key,
    image: (kidCollGlob[key] as any).default
}));

const existingCasual = kidCollImages.filter(img => 
    img.path.includes('kid_4') || img.path.includes('kid_5') || img.path.includes('kid_8') ||
    img.path.includes('kid4.png') || img.path.includes('kid5.png')
).map((img, idx) => ({ id: `kids-c-old-${idx}`, image: img.image }));

const existingOutwear = kidCollImages.filter(img => 
    img.path.includes('kid_6') || img.path.includes('kid_9') ||
    img.path.includes('jac1')
).map((img, idx) => ({ id: `kids-o-old-${idx}`, image: img.image }));

const existingSpecialized = kidCollImages.filter(img => 
    img.path.includes('kid_1') || img.path.includes('kid_2') || img.path.includes('kid_3') || img.path.includes('kid_7') ||
    img.path.includes('kid1.png') || img.path.includes('kid2.png') || img.path.includes('kidd3')
).map((img, idx) => ({ id: `kids-s-old-${idx}`, image: img.image }));

const existingNightwear = kidCollImages.filter(img => 
    img.path.toLowerCase().includes('night') || img.path.toLowerCase().includes('sleep')
).map((img, idx) => ({ id: `kids-n-old-${idx}`, image: img.image }));

// Unclassified goes to specialized
const classifiedPaths = new Set([
    ...kidCollImages.filter(img => img.path.includes('kid_4') || img.path.includes('kid_5') || img.path.includes('kid_8') || img.path.includes('kid4.png') || img.path.includes('kid5.png')).map(i => i.path),
    ...kidCollImages.filter(img => img.path.includes('kid_6') || img.path.includes('kid_9') || img.path.includes('jac1')).map(i => i.path),
    ...kidCollImages.filter(img => img.path.includes('kid_1') || img.path.includes('kid_2') || img.path.includes('kid_3') || img.path.includes('kid_7') || img.path.includes('kid1.png') || img.path.includes('kid2.png') || img.path.includes('kidd3')).map(i => i.path),
    ...kidCollImages.filter(img => img.path.toLowerCase().includes('night') || img.path.toLowerCase().includes('sleep')).map(i => i.path)
]);
const extraSpecialized = kidCollImages.filter(img => !classifiedPaths.has(img.path)).map((img, idx) => ({ id: `kids-extra-${idx}`, image: img.image }));

const categories = [
    {
        name: "Casual Tops",
        description: "Lightweight organic cotton tees, comfortable linen play shirts, and soft knit tops.",
        products: [ ...websiteKidsCasual]
    },
    {
        name: "Outerwear & Layering",
        description: "Cozy overshirts, comfortable denim layers, and easy-to-wear outer play layers.",
        products: [ ...websiteKidsOutwear]
    },
    {
        name: "Daily Outfits",
        description: "Premium organic dungarees, pocket linen rompers, jumpsuits, and floral dresses.",
        products: [ ...websiteKidsDaily]
    },
    {
        name: "Nightwear",
        description: "Comfy pajama sets and ribbed cotton sleepwear designed for premium overnight comfort.",
        products: [ ...websiteKidsNightwear]
    }
];
---

<Layout title="Children's Collection | Indido Apparel" description="Explore the latest Children's collection at Indido Apparel. Premium organic cotton overalls and linen rompers.">
    <!-- Header Section -->
    <div class="collections-title-wrapper reveal-on-scroll">
        <div class="title-line-container">
            <span class="title-line"></span>
            <h1 class="collections-title">Kid's Collection</h1>
            <span class="title-line"></span>
        </div>
        <p class="subtitle-text">Soft, breathable fabrics. Built for active playwear comfort.</p>
    </div>

    <!-- Category Selector Nav Bar -->
    <nav class="category-nav-bar reveal-on-scroll">
        {categories.map((category) => {
            const id = category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            return (
                <a href={`#${id}`} class="category-nav-link">
                    {category.name}
                </a>
            );
        })}
    </nav>

    <!-- Product Sections by Category -->
    {categories.map((category) => (
        <section class="product-grid-section" id={category.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <div class="category-header reveal-on-scroll">
                <h2 class="category-title">{category.name}</h2>
                <p class="category-desc">{category.description}</p>
                <span class="category-divider"></span>
            </div>
            <div class="product-grid">
                {category.products.map((product, idx) => (
                    <ProductCard
                        image={product.image}
                        delay={idx * 50}
                    />
                ))}
            </div>
        </section>
    ))}
    <CollectionNav />
</Layout>

<style>
    .collections-title-wrapper {
        text-align: center;
        margin: clamp(4rem, 6vw, 6rem) auto 3rem;
        padding: 0 1rem;
    }
    .title-line-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        max-width: 60rem;
        margin: 0 auto;
    }
    .title-line {
        flex-grow: 1;
        height: 1px;
        background-color: var(--ink, #17201c);
        opacity: 0.15;
    }
    .collections-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.6rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0;
        white-space: nowrap;
    }
    .subtitle-text {
        font-size: 0.8rem;
        letter-spacing: 0.05em;
        color: var(--muted, #64748b);
        margin-top: 0.8rem;
        text-transform: uppercase;
    }

    /* Product Grid Styling */
    .product-grid-section {
        background: var(--paper);
        padding-bottom: clamp(3rem, 5vw, 5rem);
    }
    .category-header {
        text-align: center;
        margin: 2rem auto 2.5rem auto;
        padding: 0 1.5rem;
        max-width: 45rem;
    }
    .category-title {
        font-family: var(--body-font), sans-serif;
        font-size: clamp(1.2rem, 2.5vw, 1.4rem);
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink, #17201c);
        margin: 0 0 0.5rem 0;
    }
    .category-desc {
        font-size: 0.88rem;
        color: var(--muted, #64748b);
        line-height: 1.6;
        margin: 0;
    }
    .category-divider {
        display: block;
        width: 3rem;
        height: 2px;
        background-color: var(--thread, #2e704a);
        margin: 1.25rem auto 0 auto;
    }
    
    /* Category Nav Bar */
    .category-nav-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.8rem;
        margin: -1rem auto 3.5rem auto;
        padding: 0.5rem 1.5rem;
        max-width: 90%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
    }
    /* Hide scrollbar but keep functionality */
    .category-nav-bar::-webkit-scrollbar {
        display: none;
    }
    .category-nav-bar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .category-nav-link {
        font-family: var(--body-font), sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted, #64748b);
        padding: 0.6rem 1.2rem;
        border-radius: 40px;
        border: 1px solid var(--line, rgba(13, 30, 21, 0.08));
        background-color: var(--cotton, #faf9f6);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        display: inline-block;
        white-space: nowrap;
        scroll-snap-align: start;
    }
    .category-nav-link:hover {
        color: var(--cotton, #faf9f6) !important;
        border-color: var(--thread, #2e704a);
        background-color: var(--thread, #2e704a);
        box-shadow: 0 4px 12px rgba(46, 112, 74, 0.15);
    }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.8rem;
        padding: 0 clamp(1rem, 4vw, 4rem);
        max-width: 90rem;
        margin: 0 auto;
    }

    /* Responsiveness */
    @media (max-width: 1024px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 768px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.2rem;
        }
    }
    @media (max-width: 480px) {
        .product-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
