---
/**
 * ServicesSlider.astro - Supply Chain Management Services Carousel
 * Renders 12 detailed services slides detailing strategic advisory, design, fabric sourcing,
 * cost optimization, production timelines, QA audits, logistics, packaging, and compliance.
 */
---

<div class="services-container reveal-on-scroll">
    <h2 class="services-main-title">Supply Chain Management</h2>
    
    <div class="services-carousel-wrapper">
        <div class="services-track">
            <!-- 1. Fashion Consulting & Strategic Advisory -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">01 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Strategic Advisory</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
                            </div>
                            <h3>Fashion Consulting &amp; Strategic Advisory</h3>
                        </div>
                        <p>Providing expert insights, market trend analysis, and strategic guidance to help you make informed decisions that align with your brand’s long-term goals.</p>
                        <ul class="info-highlights">
                            <li>Market positioning and trend forecasting</li>
                            <li>Supplier strategy and value chain alignment</li>
                            <li>Growth planning for emerging & established labels</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 2. Product Design & Development -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">02 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Design Execution</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool"><path d="m12 19 7-7 3 3-7 7-3-3z"></path><path d="m18 13-1.5-1.5"></path><path d="M14 9a3 3 0 0 0-3-3H4v7a3 3 0 0 0 3 3h3"></path></svg>
                            </div>
                            <h3>Product Design &amp; Development</h3>
                        </div>
                        <p>Working collaboratively to turn your conceptual sketches into detailed technical packs and beautiful, production-ready designs.</p>
                        <ul class="info-highlights">
                            <li>Conceptual sketches to technical pack transformation</li>
                            <li>Fabric placement and trim selection advisory</li>
                            <li>Production-ready pattern design verification</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 3. Fabric Research & Material Innovation -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">03 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Material Innovation</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            </div>
                            <h3>Fabric Research &amp; Material Innovation</h3>
                        </div>
                        <p>Sourcing the highest quality, most innovative, and sustainable textiles from around the world to give your garments a competitive edge.</p>
                        <ul class="info-highlights">
                            <li>Sourcing sustainable, organic, and recycled fibers</li>
                            <li>Technical performance fabric evaluation</li>
                            <li>Direct-from-mill raw material sourcing networks</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 4. Global Sourcing & Procurement -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">04 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Global Procurement</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                            </div>
                            <h3>Global Sourcing &amp; Procurement</h3>
                        </div>
                        <p>Leveraging our vast international network to procure the finest materials and secure the most capable manufacturing facilities for your specific product category.</p>
                        <ul class="info-highlights">
                            <li>International network covering key manufacturing hubs</li>
                            <li>Procurement of premium yarns, fabrics, and components</li>
                            <li>Multi-country sourcing plans to mitigate risk</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 5. Vendor Identification & Relationship Management -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">05 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Partner Vetting</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                            </div>
                            <h3>Vendor Identification &amp; Relationship Management</h3>
                        </div>
                        <p>Carefully vetting, auditing, and building strong, collaborative relationships with factory partners to ensure reliability and excellence.</p>
                        <ul class="info-highlights">
                            <li>Full capability assessment of manufacturing partners</li>
                            <li>Ethical, labor, and safety audit verification</li>
                            <li>Quality system evaluation before onboarding</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 6. Sampling & Product Engineering -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">06 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Prototyping &amp; Fit</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scissors"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
                            </div>
                            <h3>Sampling &amp; Product Engineering</h3>
                        </div>
                        <p>Overseeing the creation of prototypes and fit samples, making necessary technical adjustments to ensure the final product looks and feels perfect.</p>
                        <ul class="info-highlights">
                            <li>3D digital sampling and rapid physical prototyping</li>
                            <li>In-house fit analysis and measurement tuning</li>
                            <li>Pre-production sample validation for bulk runs</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 7. Costing & Strategic Negotiation -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">07 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Cost Optimization</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-percent"><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><line x1="19" y1="5" x2="5" y2="19"></line></svg>
                            </div>
                            <h3>Costing &amp; Strategic Negotiation</h3>
                        </div>
                        <p>Utilizing our industry leverage and deep market knowledge to negotiate fair, transparent, and highly competitive pricing without ever compromising on quality.</p>
                        <ul class="info-highlights">
                            <li>Open-book costing and breakdown analysis</li>
                            <li>Strategic price alignment through mill direct networks</li>
                            <li>Target price optimization without quality sacrifices</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 8. Merchandising & Production Planning -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">08 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Production Timelines</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            </div>
                            <h3>Merchandising &amp; Production Planning</h3>
                        </div>
                        <p>Meticulously planning every timeline and production schedule to ensure your collections are delivered exactly when you need them.</p>
                        <ul class="info-highlights">
                            <li>Detailed milestone tracking and critical-path planning</li>
                            <li>Weekly status reporting and risk management updates</li>
                            <li>Streamlined communication portal for rapid sign-offs</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 9. Quality Assurance & Technical Audits -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">09 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Quality Control</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <h3>Quality Assurance &amp; Technical Audits</h3>
                        </div>
                        <p>Implementing rigorous, multi-stage quality control checks and factory audits to guarantee that every single stitch meets your exacting standards.</p>
                        <ul class="info-highlights">
                            <li>Inline, mid-stage, and final AQL random inspections</li>
                            <li>Lab testing coordination for fiber, colorfastness, and safety</li>
                            <li>Strictly enforced quality standards across all production runs</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 10. Compliance & Sustainability Management -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">10 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Ethical Compliance</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-leaf"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                            </div>
                            <h3>Compliance &amp; Sustainability Management</h3>
                        </div>
                        <p>Ensuring all production processes adhere to strict ethical guidelines, labor laws, and environmental standards.</p>
                        <ul class="info-highlights">
                            <li>Certified organic and recycled fabric verification (GOTS, GRS)</li>
                            <li>Code of conduct enforcement for fair labor standards</li>
                            <li>Eco-impact monitoring in dying and finishing houses</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 11. Packaging Development -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">11 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Unboxing Aesthetics</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-box"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><polygon points="12 22.08 12 12 3 6.92 3 17.08 12 22.08"></polygon><polygon points="12 22.08 21 17.08 21 6.92 12 12 12 22.08"></polygon><polygon points="12 12 21 6.92 12 1.92 3 6.92 12 12"></polygon></svg>
                            </div>
                            <h3>Packaging Development</h3>
                        </div>
                        <p>Designing and sourcing attractive, protective, and eco-friendly packaging that enhances your customer's unboxing experience.</p>
                        <ul class="info-highlights">
                            <li>FSC-certified paper, cornstarch polybags, and compostable packaging</li>
                            <li>Retail-ready presentation boxes and garment bags</li>
                            <li>Reduced material volume designs to optimize shipping costs</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 12. Logistics & Supply Chain Coordination -->
            <div class="service-slide">
                <div class="service-flow-card">
                    <div class="card-info">
                        <div class="card-meta">
                            <span class="slide-num">12 / 12</span>
                            <span class="meta-sep">•</span>
                            <span class="info-tag">Global Logistics</span>
                        </div>
                        <div class="title-row">
                            <div class="decor-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            </div>
                            <h3>Logistics &amp; Supply Chain Coordination</h3>
                        </div>
                        <p>Managing the complex web of global shipping, customs clearance, and final delivery so your products arrive safely at your door.</p>
                        <ul class="info-highlights">
                            <li>Freight forwarding booking (Air, Ocean, Rail, Courier)</li>
                            <li>Customs clearance documents and HTS code classification</li>
                            <li>Final destination tracking and last-mile delivery management</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls panel -->
    <div class="carousel-controls">
        <button class="carousel-btn prev" aria-label="Previous service" disabled="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="carousel-pagination">
            <span class="carousel-indicator-text">Service 01 of 12</span>
            <div class="dots-wrapper">
                {Array.from({ length: 12 }).map((_, i) => (
                    <button class={`dot-indicator ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Go to service ${i+1}`}></button>
                ))}
            </div>
        </div>
        <button class="carousel-btn next" aria-label="Next service">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right"><path d="m9 18 6-6-6-6"/></svg>
        </button>
    </div>
</div>

<style>
    /* Specialized Services Carousel Slider Styles */
    .services-container {
        margin-top: 5rem;
        padding-top: 5rem;
        border-top: 1px solid var(--line);
        width: 100%;
        text-align: left;
    }
    .services-main-title {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 2.5rem;
        font-weight: 400;
        color: var(--ink);
        margin-bottom: 4rem;
        text-align: center;
        position: relative;
        padding-bottom: 0.85rem;
    }
    .services-main-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 3.5rem;
        height: 2px;
        background: var(--thread);
    }

    .services-carousel-wrapper {
        position: relative;
        overflow: hidden;
        width: 100%;
        border-radius: 8px;
    }

    .services-track {
        display: flex;
        transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        width: 100%;
    }

    .service-slide {
        width: 100%;
        flex-shrink: 0;
        padding: 0.2rem;
    }

    .service-flow-card {
        display: block; /* Unified 1-column layout */
        background: var(--cotton);
        border: 1px solid var(--line);
        border-radius: 8px;
        min-height: 22rem;
        overflow: hidden;
        box-shadow: 0 1rem 3.5rem rgba(23, 32, 28, 0.03);
        transition: border-color 0.4s ease;
    }
    .service-flow-card:hover {
        border-color: var(--thread);
    }

    .card-meta {
        display: flex;
        align-items: center;
        justify-content: center; /* Center horizontally */
        gap: 0.8rem;
        margin-bottom: 1rem;
    }
    .slide-num {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 1.2rem;
        color: var(--thread);
        font-weight: 400;
    }
    .meta-sep {
        color: var(--line);
        font-size: 0.9rem;
    }
    .info-tag {
        font-size: 0.9rem; /* Increased size */
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 800; /* Bold */
        color: var(--ink); /* Prominent coloring */
    }

    .title-row {
        display: flex;
        align-items: center;
        justify-content: center; /* Center horizontally */
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .decor-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .decor-icon svg {
        width: 2.5rem;
        height: 2.5rem;
        padding: 0.55rem;
        stroke-width: 2;
        color: var(--thread);
        background: rgba(46, 112, 74, 0.06);
        border-radius: 50%;
        border: 1px solid rgba(46, 112, 74, 0.15);
        transition: transform 0.4s ease, background-color 0.4s ease, border-color 0.4s ease;
    }
    .service-flow-card:hover .decor-icon svg {
        transform: scale(1.1) rotate(4deg);
        background: rgba(46, 112, 74, 0.12);
        border-color: var(--thread);
    }

    .card-info {
        padding: clamp(2rem, 4vw, 3rem);
        text-align: center; /* Center everything inside card-info */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .card-info h3 {
        font-family: 'Helvetica Light', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: clamp(1.3rem, 2vw, 1.8rem);
        font-weight: 400;
        color: var(--ink);
        margin: 0;
        line-height: 1.2;
    }
    .card-info p {
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted);
        margin: 0 auto 1.5rem auto;
        max-width: 48rem;
        text-align: center; /* Center description text */
    }
    .info-highlights {
        list-style-type: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center; /* Center highlights */
        gap: 0.6rem;
    }
    .info-highlights li {
        position: relative;
        padding-left: 0; /* Remove left padding */
        font-size: 0.95rem;
        color: var(--ink);
        font-weight: 500;
        text-align: center; /* Center bullet text */
    }
    .info-highlights li::before {
        content: '•';
        color: var(--thread); /* Terracotta */
        margin-right: 0.5rem;
        display: inline-block;
        font-weight: 800;
        font-size: 1.1rem;
        line-height: 1;
    }

    /* Carousel controls panel */
    .carousel-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 1rem 1.5rem;
        background: var(--cotton);
    }
    .carousel-btn {
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 50%;
        width: 2.8rem;
        height: 2.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--ink);
        transition: all 0.3s ease;
    }
    .carousel-btn:hover:not([disabled]) {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
        transform: scale(1.05);
    }
    .carousel-btn[disabled] {
        opacity: 0.35;
        cursor: not-allowed;
    }
    .carousel-pagination {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }
    .carousel-indicator-text {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--thread);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .dots-wrapper {
        display: flex;
        gap: 0.4rem;
    }
    .dot-indicator {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--line);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .dot-indicator.active {
        background: var(--thread);
        transform: scale(1.5);
    }

    @media (max-width: 768px) {
        /* Carousel mobile adjustments */
        .services-container {
            margin-top: 3.5rem;
            padding-top: 2.5rem;
        }
        .card-info {
            padding: 1.5rem;
        }
        .title-row {
            gap: 0.8rem;
            margin-bottom: 1.2rem;
        }
        .decor-icon svg {
            width: 2.2rem;
            height: 2.2rem;
            padding: 0.45rem;
        }
        .carousel-indicator-text {
            font-size: 0.72rem;
        }
        .dot-indicator {
            width: 5px;
            height: 5px;
        }
    }
</style>

<script>
    // Services slider carousel functionality with flow transition and 4s autoplay
    const initCarousel = () => {
        const track = document.querySelector('.services-track') as HTMLElement;
        const slides = document.querySelectorAll('.service-slide');
        const prevBtn = document.querySelector('.carousel-btn.prev');
        const nextBtn = document.querySelector('.carousel-btn.next');
        const dots = document.querySelectorAll('.dot-indicator');
        const currentLabel = document.querySelector('.carousel-indicator-text');
        
        if (!track || slides.length === 0) return;
        
        let currentIndex = 0;
        let timer: any = null;
        
        const updateSlider = (index: number) => {
            track.style.transform = `translateX(-${index * 100}%)`;
            
            // Update dots
            dots.forEach((dot, idx) => {
                if (idx === index) dot.classList.add('active');
                else dot.classList.remove('active');
            });
            
            // Update text label
            if (currentLabel) {
                const formattedNum = String(index + 1).padStart(2, '0');
                currentLabel.textContent = `Service ${formattedNum} of 12`;
            }
            
            // Enable/disable buttons
            if (prevBtn) {
                if (index === 0) prevBtn.setAttribute('disabled', 'true');
                else prevBtn.removeAttribute('disabled');
            }
            if (nextBtn) {
                if (index === slides.length - 1) nextBtn.setAttribute('disabled', 'true');
                else nextBtn.removeAttribute('disabled');
            }
        };

        const startAutoplay = () => {
            stopAutoplay();
            timer = setInterval(() => {
                currentIndex = (currentIndex + 1) % slides.length;
                updateSlider(currentIndex);
            }, 4000);
        };

        const stopAutoplay = () => {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        };
        
        prevBtn?.addEventListener('click', () => {
            stopAutoplay();
            if (currentIndex > 0) {
                currentIndex--;
                updateSlider(currentIndex);
            }
            startAutoplay();
        });
        
        nextBtn?.addEventListener('click', () => {
            stopAutoplay();
            if (currentIndex < slides.length - 1) {
                currentIndex++;
            } else {
                currentIndex = 0; // Wrap around on user click of next at end
            }
            updateSlider(currentIndex);
            startAutoplay();
        });
        
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                stopAutoplay();
                currentIndex = index;
                updateSlider(currentIndex);
                startAutoplay();
            });
        });
        
        // Touch events for mobile swipe support
        let touchStartX = 0;
        let touchEndX = 0;
        
        track.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        track.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const swipeDistance = touchEndX - touchStartX;
            const threshold = 50; // min sweep pixels
            
            if (Math.abs(swipeDistance) > threshold) {
                stopAutoplay();
                if (swipeDistance < 0) {
                    // Swiped left -> next
                    if (currentIndex < slides.length - 1) {
                        currentIndex++;
                        updateSlider(currentIndex);
                    }
                } else {
                    // Swiped right -> prev
                    if (currentIndex > 0) {
                        currentIndex--;
                        updateSlider(currentIndex);
                    }
                }
                startAutoplay();
            }
        }, { passive: true });

        // Initial setup and start autoplay
        updateSlider(0);
        startAutoplay();
    };
    
    // Run initializations
    initCarousel();
    
    // Re-initialize after Astro page swaps
    document.addEventListener('astro:after-swap', () => {
        initCarousel();
    });
</script>
