---
/**
 * HomeContact.astro - Homepage Contact CTA Section
 * Displays the contact card with direct email links.
 */
---

<section class="contact-section" id="contact">
    <div class="contact-card reveal-on-scroll scale-up">
        <!-- Left part: logo, title, and email button -->
        <div class="contact-left">
            <h2 class="reveal-on-scroll split-text-scroll">Contact Indido<em>Apparel</em></h2>
            <div class="reveal-fade" style="margin-top: 1.75rem; animation-delay: 400ms;">
                <a class="contact-button" href="mailto:Info.in@indidoapparel.com">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-mail" aria-hidden="true">
                        <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    </svg>
                    <span>Contact Us</span>
                </a>
            </div>
        </div>

        <!-- Right part: description content (formerly Center part) -->
        <div class="contact-center">
            <p class="contact-desc reveal-on-scroll split-text-scroll">
                Whether you are preparing a range plan for the upcoming season, developing new custom fabrics, or looking for a dependable manufacturing partner in India, our production and quality teams are ready to help. Send us your specifications or design briefs, and we will get back to you within 24 hours.
            </p>
        </div>
    </div>
</section>
